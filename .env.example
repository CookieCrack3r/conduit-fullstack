# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# .env is git-ignored on purpose - it holds credentials and the deployment
# address, neither of which belong in a repository.

# -----------------------------------------------------------------------------
# Deployment address
# -----------------------------------------------------------------------------
# Host or IP the browser uses to reach this deployment.
# Use "localhost" for local runs, or the public address of your VM.
# NOTE: the frontend bakes this into its bundle at BUILD time. After changing
# it, rebuild with `docker compose up -d --build`, not just restart.
PUBLIC_HOST=localhost

FRONTEND_PORT=8282
BACKEND_PORT=8000

# -----------------------------------------------------------------------------
# Django
# -----------------------------------------------------------------------------
# Generate a fresh one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-me-with-a-generated-secret
DJANGO_DEBUG=False
GUNICORN_WORKERS=3

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_DB=conduit
POSTGRES_USER=conduit
POSTGRES_PASSWORD=replace-me-with-a-strong-password

# -----------------------------------------------------------------------------
# Django admin account (optional)
# -----------------------------------------------------------------------------
# When username and email are both set, the entrypoint creates this account on
# first start. Leave empty to skip and use `createsuperuser` manually.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=replace-me-with-a-strong-password
